# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "ollama" for local models or "cloudflare" for cloud inference
LLM_PROVIDER=ollama

# ─── Cloudflare Workers AI ─────────────────────────────────────────────────────
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_LLM_MODEL=@cf/meta/llama-3-8b-instruct
CF_EMBED_MODEL=@cf/baai/bge-large-en-v1.5

# ─── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Redis (Celery broker + cache) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant (vector database) ──────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=   # Only needed for Qdrant Cloud

# ─── MongoDB Atlas (persistent storage) ────────────────────────────────────────
# Leave blank to use local JSON fallback automatically
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=qrag_db

# ─── Graph & Quantum ───────────────────────────────────────────────────────────
GRAPH_STORE_PATH=graph_store.json
MAX_QUBITS=14
